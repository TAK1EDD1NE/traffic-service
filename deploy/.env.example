# Copy to deploy/.env (gitignored) for local runs; set the same keys in Coolify.
# FRESH VOLUME: web mounts the volume's `out/` subpath and crash-loops (restart: always)
# until it exists — create it once, before the first web start, with the migrate/seed one-shot:
#   docker compose -f deploy/compose.prod.yml --env-file deploy/.env run --rm worker \
#     sh -c 'mkdir -p /data/out /data/raw /data/dump'
POSTGRES_USER=traffic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=traffic
# ntfy topic (or any endpoint that accepts a plain-text POST). Empty = log-only alerts.
ALERT_WEBHOOK_URL=
# Pin what Coolify pulls; build with `deploy/build-worker.sh <tag>` / `build-web.sh <tag>`.
TRAFFIC_WORKER_IMAGE=ghcr.io/tak1edd1ne/traffic-worker:latest
TRAFFIC_WEB_IMAGE=ghcr.io/tak1edd1ne/traffic-web:latest
